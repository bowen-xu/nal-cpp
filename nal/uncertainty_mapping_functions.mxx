module;

#include <cmath>
#include <algorithm>
#include <numeric>
#include <initializer_list>
#include <tuple>
#include <utility>
export module non_axomatic_logic:uncertainty_mapping_functions;
import std;
import :truth_value;

using namespace std;

export namespace NAL
{
    inline TruthV truth_from_w(float w_plus, float w, float k = 1.0)
    {
        float f, c;
        if (w != 0)
        {
            f = w_to_f(w_plus, w);
            c = w_to_c(w, k);
        }
        else
        {
            f = 0.5;
            c = 0.0;
        }
        return TruthV(f, c, k);
    }

    inline void w_from_truth(TruthV &truth, double &o__w_plus, double &o__w_minus)
    {
        auto &f = truth.f;
        auto &c = truth.c;
        auto &k = truth.k;
        o__w_plus = fc_to_w_plus(f, c, k);
        o__w_minus = fc_to_w_minus(f, c, k);
    }

    inline pair<double, double> w_from_truth(TruthV &truth)
    {
        double w_plus, w_minus;
        w_from_truth(truth, w_plus, w_minus);
        return {w_plus, w_minus};
    }

} // namespace NAL